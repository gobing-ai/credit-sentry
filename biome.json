{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!**/.claude", "!**/dist", "!**/.coverage", "!**/node_modules", "!**/vendors"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "error"
            },
            "complexity": {
                "noUselessConstructor": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "yaml": {
        "formatter": {
            "enabled": false
        }
    },
    "markdown": {
        "formatter": {
            "enabled": false
        }
    },
    "css": {
        "formatter": {
            "quoteStyle": "double"
        },
        "parser": {
            "cssModules": true,
            "tailwindDirectives": true
        }
    }
}
